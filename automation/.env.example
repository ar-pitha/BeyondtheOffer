# Copy to .env and fill in. In GitHub Actions these come from repository secrets.

MONGO_URI=                       # same Atlas URI as the backend
AUTOMATION_USER_EMAIL=           # optional: admin account that "posts" synced items (default: first admin)
SHEET_ID=1wMs0w53J7STUPeFuP7mlE-QTKLG9UP97_JXJl-BtGdI
GOOGLE_SA_JSON_PATH=./secrets/google-sa.json   # local only
GOOGLE_SA_JSON_B64=                            # GitHub/Vercel: base64 of the JSON

IG_USER_ID=
IG_ACCESS_TOKEN=
IG_LOGIN_TYPE=unified           # unified or instagram
IG_TOKEN_ISSUED_AT=              # YYYY-MM-DD the long-lived token was generated (for refresh reminders)
IG_APP_ID=
IG_APP_SECRET=
IG_API_BASE=https://graph.facebook.com
IG_API_VERSION=v26.0

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional: sharper company logos on carousel slides (logo.dev publishable key)
LOGO_DEV_TOKEN=

TIMEZONE=Asia/Kolkata
POST_SLOTS_IST=13:00,19:00
# manual | auto: publish reels as trial reels shown to non-followers first (empty = normal reels)
REEL_TRIAL=
CONTENT_ROTATION_IST=tech,news,govt,events,ai
DRY_RUN=true
WEBSITE_URL=https://beyondtheoffer.vercel.app

# Admin "Post now" button: GitHub fine-grained token for ar-pitha/BeyondtheOffer with Actions: Read and write
GH_DISPATCH_TOKEN=

# YouTube Shorts (reels are cross-posted when all three are set). Desktop-app OAuth client;
# run "node lib/youtube.js auth" once to get the refresh token. Uploads stay private until
# the API project passes YouTube's audit; then set YT_PRIVACY=public.
YT_CLIENT_ID=
YT_CLIENT_SECRET=
YT_REFRESH_TOKEN=
YT_PRIVACY=private
